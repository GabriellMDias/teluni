# Local API development example. Copy to .env.local; never commit real values.
# The keys and safe defaults below are checked against apps/api/src/config.ts.
# See docs/setup.md and docs/generated/configuration/api.md.
ORION_ENV=development

# ORION_RELEASE_ID=local  # Actual artifact revision for correlated logs and traces; local for unversioned development.
# ORION_API_HOST=127.0.0.1  # Listen address; loopback by default.
# ORION_API_PORT=3000  # Listen port; zero selects an ephemeral port.
# TELUNI_TRUSTED_PROXIES: Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are trusted, so request limits count the real client address; none by default.
# ORION_LOG_LEVEL=info  # Structured log threshold.
# ORION_SHUTDOWN_TIMEOUT_MS=5000  # Total graceful shutdown deadline.
# ORION_OTLP_ENDPOINT: Optional OTLP HTTP collector base URL.
# ORION_TRACE_SAMPLE_RATIO=1  # Trace sampling probability.
# ORION_DATABASE_URL: Runtime PostgreSQL credential; enables the database for modules that require it and adds it to readiness.
# ORION_TOKEN_ISSUER: Expected access-token issuer; configure with audience and JWKS URL to enable bearer authentication.
# ORION_TOKEN_AUDIENCE: Expected API access-token audience.
# ORION_TOKEN_JWKS_URL: Trusted issuer public-key endpoint.
# TELUNI_PUBLIC_ORIGIN: Browser-visible panel origin for OIDC callbacks, cookie security and CSRF origin checks; HTTPS outside loopback development.
# TELUNI_OIDC_CLIENT_ID: Confidential human-login OIDC client used by the server-managed session boundary.
# TELUNI_OIDC_CLIENT_SECRET: Credential of the human-login OIDC client.
# TELUNI_IDENTITY_PROVISIONER_CLIENT_ID: Service-account client that writes the administrator-only application principal attribute.
# TELUNI_IDENTITY_PROVISIONER_CLIENT_SECRET: Credential of the principal provisioner service account.
# TELUNI_SESSION_KEYS: Key ring for provider-token encryption and CSRF tokens; the first key protects new values, all keys remain readable during rotation.
# TELUNI_MAIL_SMTP_HOST: SMTP submission relay for transactional email; configure with the sender and mail key ring to enable the mail module.
# TELUNI_MAIL_SMTP_PORT=587  # SMTP submission relay port.
# TELUNI_MAIL_SMTP_SECURITY=starttls  # Implicit TLS or mandatory STARTTLS with certificate verification; none only for a loopback test sink outside production.
# TELUNI_MAIL_SMTP_USERNAME: SMTP authentication user; configured together with the password, or both omitted for an unauthenticated test sink.
# TELUNI_MAIL_SMTP_PASSWORD: SMTP authentication credential of the mail relay.
# TELUNI_MAIL_FROM: Sender address of transactional email; its domain must be authorized for the relay.
# TELUNI_MAIL_KEYS: Key ring sealing secret message parameters, such as invitation credentials, until delivery ends; the first key protects new values.
# TELUNI_DEVICE_CODE_KEYS: Key ring for the HMAC that stores screen pairing codes; the first key protects new codes, all keys remain readable during rotation. Enables the devices module.
# TELUNI_MEDIA_STORAGE_PATH: Directory on durable storage that holds media objects and work files on one filesystem; enables the media module.
# TELUNI_MEDIA_FFMPEG_PATH=ffmpeg  # FFmpeg 6.1 or later executable that converts media in isolated child processes.
# TELUNI_MEDIA_FFPROBE_PATH=ffprobe  # ffprobe 6.1 or later executable that inspects uploaded media in isolated child processes.
# TELUNI_MEDIA_PROCESSING_CONCURRENCY=1  # Media processing jobs this API process runs at once.
# TELUNI_SYNC_SIGNING_KEYS: Key ring that signs screen authorization statements (ADR-0030); the first key signs, and every key's public half stays available to screens during rotation. Enables the publications module.
