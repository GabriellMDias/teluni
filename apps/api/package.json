{
  "name": "@teluni/api",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "dev:services": "tsx scripts/dev-services.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "references:write": "tsx scripts/generate-references.ts --write",
    "references:check": "tsx scripts/generate-references.ts --check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/otel": "0.21.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "nodemailer": "10.1.2",
    "openid-client": "6.8.8",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "temporal-polyfill": "1.0.5",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/pg": "8.16.0",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
