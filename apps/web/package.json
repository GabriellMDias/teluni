{
  "name": "@teluni/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "identity:write": "node scripts/generate-touch-icon.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle.mjs && node scripts/check-public-bundle.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:e2e": "playwright test",
    "test:documentation": "node --test scripts/documentation-build.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "@teluni/sdk": "workspace:*",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.34",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.5",
    "jose": "6.2.12",
    "oxc-transform-react": "0.145.0",
    "pg": "8.16.3",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
