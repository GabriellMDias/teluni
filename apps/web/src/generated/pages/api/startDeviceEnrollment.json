                "display": {
                  "type": "object",
                  "required": ["width", "height"],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16384
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16384
                    }
                  },
                  "additionalProperties": false
                },
                "rotations": {
