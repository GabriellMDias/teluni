              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "report": {
              "type": "object",
              "required": [
                "appVersion",
                "protocolVersion",
                "manufacturer",
                "model",
                "osVersion",
                "display",
                "rotations"
              ],
              "properties": {
                "appVersion": {
                  "type": "string",
