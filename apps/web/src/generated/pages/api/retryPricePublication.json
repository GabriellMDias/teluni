              },
              "state": {
                "anyOf": [
                  { "type": "string", "const": "pending" },
                  { "type": "string", "const": "published" },
                  { "type": "string", "const": "skipped" },
                  { "type": "string", "const": "blocked" },
                  { "type": "string", "const": "failed" }
                ]
              },
              "reason": {
                "anyOf": [
                  {
