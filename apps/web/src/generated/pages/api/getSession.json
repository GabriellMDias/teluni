{
  "kind": "api",
  "operationId": "getSession",
  "summary": "",
  "description": "Describe the current session and return its CSRF token for unsafe requests. A PENDING_LIMIT session must end another session before protected operations. Send x-teluni-activity: background from automatic polling so it does not extend the idle limit.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "GET",
  "path": "/auth/session",
  "tags": ["Identity"],
  "authentication": "Session cookie",
  "parameters": [],
  "request": null,
  "responses": [
    {
      "status": "200",
      "description": "Response",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "principalId",
              "sessionId",
              "state",
              "expiresAt",
              "assuranceLevel",
              "authenticatedAt",
              "strongAuthenticatedAt",
              "csrfToken"
            ],
            "properties": {
              "principalId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "sessionId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "state": {
                "anyOf": [
                  { "type": "string", "const": "ACTIVE" },
                  { "type": "string", "const": "PENDING_LIMIT" }
                ]
              },
              "expiresAt": { "type": "string", "format": "date-time" },
              "assuranceLevel": { "type": "string", "maxLength": 64 },
              "authenticatedAt": { "type": "string", "format": "date-time" },
              "strongAuthenticatedAt": {
                "anyOf": [
                  { "type": "string", "format": "date-time" },
                  { "type": "null" }
                ]
              },
              "csrfToken": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
