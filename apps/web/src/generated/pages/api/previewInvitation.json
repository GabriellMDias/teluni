{
  "kind": "api",
  "operationId": "previewInvitation",
  "summary": "",
  "description": "Describe the invitation a credential refers to, without effect, to the signed-in person whose verified email is its recipient. The credential travels only in the body.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "POST",
  "path": "/invitations/preview",
  "tags": ["Invitations"],
  "authentication": "Session cookie",
