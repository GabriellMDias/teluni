{
  "kind": "api",
  "operationId": "checkScheduleRules",
  "summary": "",
  "description": "Check a schedule set without saving it: schedules whose start equals their end, and each pair of overlapping schedules (by index) with the first local date on which they overlap. Validation uses local wall-clock time, so it holds in every zone.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "POST",
  "path": "/companies/{companyId}/programming/rule-checks",
  "tags": ["Programming"],
  "authentication": "Session cookie",
  "parameters": [
    {
      "name": "companyId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)",
      "description": ""
    }
  ],
  "request": {
    "required": true,
    "description": "",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["rules"],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["playlistId", "weekdays", "allDay", "startsOn"],
                "properties": {
                  "playlistId": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                  },
                  "weekdays": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1, "maximum": 7 },
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true
                  },
                  "allDay": { "type": "boolean" },
                  "startTime": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      { "type": "null" }
                    ]
                  },
                  "endTime": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      { "type": "null" }
                    ]
                  },
                  "startsOn": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "endsOn": {
                    "anyOf": [
                      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                      { "type": "null" }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 200
            }
          },
          "additionalProperties": false
        }
      }
    },
