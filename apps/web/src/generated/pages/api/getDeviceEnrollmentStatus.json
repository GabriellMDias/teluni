{
  "kind": "api",
  "operationId": "getDeviceEnrollmentStatus",
  "summary": "",
  "description": "Poll an enrollment with the credential whose hash started it, at most once per polling interval. Answers pending, paired with the device ID, or expired. Polling too fast answers RATE_LIMITED with Retry-After.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "POST",
  "path": "/device-enrollments/{enrollmentId}/status",
  "tags": ["Devices"],
  "authentication": "Bearer access token",
  "parameters": [
    {
      "name": "enrollmentId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)",
      "description": ""
    }
  ],
  "request": null,
  "responses": [
    {
      "status": "200",
      "description": "Response",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["status", "deviceId", "pollIntervalSeconds"],
            "properties": {
              "status": {
                "anyOf": [
                  { "type": "string", "const": "pending" },
                  { "type": "string", "const": "paired" },
                  { "type": "string", "const": "expired" }
                ]
              },
              "deviceId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                  },
                  { "type": "null" }
                ]
              },
              "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "schema": {
        "type": "object",
        "required": ["status", "deviceId", "pollIntervalSeconds"],
        "properties": {
          "status": {
            "anyOf": [
              { "type": "string", "const": "pending" },
              { "type": "string", "const": "paired" },
              { "type": "string", "const": "expired" }
            ]
          },
          "deviceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              { "type": "null" }
            ]
          },
          "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "fields": [
        {
          "name": "status",
          "type": "\"pending\" | \"paired\" | \"expired\"",
          "required": true
        },
        {
          "name": "deviceId",
          "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$) | null",
          "required": true
        },
        {
          "name": "pollIntervalSeconds",
          "type": "integer (minimum 1)",
