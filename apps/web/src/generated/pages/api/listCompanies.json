{
  "kind": "api",
  "operationId": "listCompanies",
  "summary": "",
  "description": "List companies with a current active membership, newest first by immutable creation time and ID, with the caller's effective roles. Cursors are bound to the caller and collection; membership is checked again on every page. The default page has 50 entries, with a maximum of 100. Other members' companies are never visible.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "GET",
  "path": "/companies",
  "tags": ["Organizations"],
  "authentication": "Session cookie",
  "parameters": [
    {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": { "type": "integer", "minimum": 1, "maximum": 100 },
      "type": "integer (minimum 1, maximum 100)",
      "description": ""
    },
    {
      "name": "cursor",
      "in": "query",
      "required": false,
      "schema": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "type": "string (min length 1, max length 1024)",
      "description": ""
    }
  ],
