                  "type": "object",
                  "required": ["id", "displayName", "status", "roles"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": ".*\\S.*"
                    },
                    "status": {
                      "anyOf": [
                        { "type": "string", "const": "ACTIVE" },
                        { "type": "string", "const": "SUSPENDED" }
                      ]
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "COMPANY_ADMINISTRATOR"
                          },
                          { "type": "string", "const": "BRANCH_MANAGER" },
                          { "type": "string", "const": "OPERATOR" }
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "nextCursor": {
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              }
            },
            "additionalProperties": false
          }
        }
      },
