{
  "kind": "api",
  "operationId": "getDeviceWidgetData",
  "summary": "",
  "description": "Live weather and RSS headline data for the screen's current desired publication only. Sources come from its immutable manifest, never from caller input. Bounded server caches protect providers; stale data is usable for at most 24 hours from fetchedAt. Clock, ticker and QR render from the manifest without this endpoint.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "GET",
  "path": "/device/publications/{publicationId}/widgets",
  "tags": ["Publications"],
  "authentication": "Bearer access token",
  "parameters": [
    {
      "name": "publicationId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)",
      "description": ""
    }
  ],
