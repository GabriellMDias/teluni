                  "properties": {
                    "areaKey": { "type": "string" },
                    "live": {
                      "type": "object",
                      "required": ["status", "fetchedAt", "validUntil", "data"],
                      "properties": {
                        "status": {
                          "anyOf": [
                            { "type": "string", "const": "ready" },
                            { "type": "string", "const": "stale" },
                            { "type": "string", "const": "unavailable" }
                          ]
                        },
                        "fetchedAt": {
                          "anyOf": [
                            { "type": "string", "format": "date-time" },
                            { "type": "null" }
                          ]
                        },
                        "validUntil": {
                          "anyOf": [
                            { "type": "string", "format": "date-time" },
                            { "type": "null" }
                          ]
                        },
                        "data": {
                          "anyOf": [
                            {
                              "type": "object",
                              "required": [
                                "type",
                                "temperatureC",
                                "humidity",
                                "symbol",
                                "forecastAt"
                              ],
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "weather"
                                },
                                "temperatureC": { "type": "number" },
                                "humidity": { "type": "number" },
                                "symbol": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64
                                },
                                "forecastAt": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "additionalProperties": false
                            },
                            {
