            "active",
            "recovery",
            "staging",
            "playback",
            "storage",
            "deviceTime"
          ],
          "properties": {
            "protocols": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "minItems": 1,
              "maxItems": 8
            },
