{
  "kind": "api",
  "operationId": "getDeviceKeys",
  "summary": "",
  "description": "The public keys that verify authorization statements, as a JSON Web Key Set, newest first. The screen pins them after pairing and fetches them again when a statement names an unknown key.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "GET",
  "path": "/device/keys",
  "tags": ["Publications"],
