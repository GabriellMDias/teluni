{
  "kind": "api",
  "operationId": "rotateDeviceCredential",
  "summary": "",
  "description": "Register the hash of a new device-generated credential. The current credential keeps working until the new one is first used, so a lost response is safe; repeating the same hash is harmless.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "POST",
  "path": "/device/self/credential",
  "tags": ["Devices"],
  "authentication": "Bearer access token",
  "parameters": [],
  "request": {
    "required": true,
    "description": "",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["credentialHash"],
          "properties": {
            "credentialHash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
