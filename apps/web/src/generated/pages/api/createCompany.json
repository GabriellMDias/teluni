{
  "kind": "api",
  "operationId": "createCompany",
  "summary": "",
  "description": "Create a company whose creator becomes its responsible administrator. A repeated Idempotency-Key from the same person with the same content returns the same company; different content is rejected. Further administration requires two-step verification.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "POST",
  "path": "/companies",
  "tags": ["Organizations"],
  "authentication": "Session cookie",
