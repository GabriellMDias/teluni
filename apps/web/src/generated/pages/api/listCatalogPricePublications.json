{
  "kind": "api",
  "operationId": "listCatalogPricePublications",
  "summary": "",
  "description": "The catalog's 50 most recent price publications, newest first: one per program whose latest publication shows the catalog, queued by a price change and published by the price processor as a new generation that changes only this catalog's prices. A pending intent coalesces later changes; the generation names the publication an intent produced or found already including its prices. Programs the caller cannot see have no target. Needs catalogs.view on the catalog.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "GET",
  "path": "/companies/{companyId}/catalogs/{catalogId}/price-publications",
  "tags": ["Publications"],
  "authentication": "Session cookie",
  "parameters": [
    {
      "name": "companyId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)",
