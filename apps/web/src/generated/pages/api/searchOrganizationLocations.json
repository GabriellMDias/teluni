{
  "kind": "api",
  "operationId": "searchOrganizationLocations",
  "summary": "",
  "description": "Search the bundled GeoNames city catalog with accent-insensitive city, region and ISO country-code terms. Returns at most 20 population-ranked results. Use a city to center the map before selecting a branch point; no address or location query is sent to an external provider. Data by GeoNames, CC BY 4.0.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
  "method": "GET",
  "path": "/organization-locations",
  "tags": ["Organizations"],
  "authentication": "Session cookie",
