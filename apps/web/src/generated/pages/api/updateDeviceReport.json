{
  "kind": "api",
  "operationId": "updateDeviceReport",
  "summary": "",
  "description": "Replace the active screen's report of its application, model, display and supported rotations. Reports are device statements, not qualified support.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "PUT",
  "path": "/device/self/report",
  "tags": ["Devices"],
  "authentication": "Bearer access token",
  "parameters": [],
  "request": {
    "required": true,
    "description": "",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "appVersion",
            "protocolVersion",
            "manufacturer",
            "model",
            "osVersion",
            "display",
            "rotations"
          ],
          "properties": {
            "appVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "protocolVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "manufacturer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "osVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "display": {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
                "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
              },
              "additionalProperties": false
            },
            "rotations": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "number", "const": 0 },
                  { "type": "number", "const": 90 },
                  { "type": "number", "const": 180 },
                  { "type": "number", "const": 270 }
                ]
              },
              "minItems": 1,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        }
      }
    },
