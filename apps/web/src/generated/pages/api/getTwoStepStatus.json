{
  "kind": "api",
  "operationId": "getTwoStepStatus",
  "summary": "",
  "description": "Whether the caller's account has two-step verification (an authenticator app) enabled. It is optional for each person; enable or disable it through startLogin with twoStep.",
  "security": [{ "sessionCookie": [] }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-teluni_session",
        "description": "Opaque server-managed human session. Loopback development uses teluni_session. Unsafe methods also require the session CSRF token in X-CSRF-Token and a matching Origin."
      }
    }
  },
