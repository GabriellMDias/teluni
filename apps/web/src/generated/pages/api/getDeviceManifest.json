{
  "kind": "api",
  "operationId": "getDeviceManifest",
  "summary": "",
  "description": "The exact manifest bytes (UTF-8 JSON) of the screen's current desired publication; their SHA-256 is the one the statement lists. Any other publication answers RESOURCE_NOT_FOUND, after which the screen synchronizes again.",
  "security": [{ "deviceCredential": [] }],
  "components": {
    "securitySchemes": {
      "deviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A screen's own 256-bit credential, generated by the player and registered only as its SHA-256 when enrollment starts (ADR-0027). Never accepted on human routes."
      }
    }
  },
  "method": "GET",
  "path": "/device/publications/{publicationId}/manifest",
  "tags": ["Publications"],
  "authentication": "Bearer access token",
  "parameters": [
    {
      "name": "publicationId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "type": "string (pattern ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)",
      "description": ""
    }
  ],
