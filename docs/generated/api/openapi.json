                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "ok"
                        },
                        {
                          "type": "string",
                          "const": "unavailable"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
